# Multiplier environment. Values here are public addresses (no secrets). Copy to .env.development / .env.production.
# Neon Auth URL (neonctl neon-auth status --branch <branch>)
VITE_NEON_AUTH_URL=
# Neon Data API URL (neonctl data-api get --branch <branch> --database neondb)
VITE_NEON_DATA_API_URL=
# Neon Function "game" invocation URL (npm run deploy:game -- --branch <branch>)
VITE_GAME_URL=
# Never put the database connection string here.
